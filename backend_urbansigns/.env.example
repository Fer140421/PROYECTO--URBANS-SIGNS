# Copiar como .env o exportar estas variables en el entorno de ejecución (Render, Railway, VPS, etc.).
# Nunca colocar valores reales en este archivo de ejemplo.

PORT=8080

# Base de datos (ej. Supabase: jdbc:postgresql://aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=require)
DB_URL=jdbc:postgresql://localhost:5432/urban_signs
DB_USERNAME=postgres
DB_PASSWORD=change-me

# En producción con datos listos: 'none' o 'validate'. En desarrollo inicial: 'update'.
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false

# Clave secreta JWT (al menos 32 caracteres)
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-bytes

# Configuración de Cookies JWT
# Para producción en HTTPS y dominios separados (ej. Vercel a Render): secure=true, same-site=None
# Para desarrollo local sin HTTPS: secure=false, same-site=Lax
JWT_COOKIES_SECURE=true
JWT_COOKIES_SAMESITE=None

# Orígenes permitidos para Frontend y Landing (separados por coma, soporta patrones como https://*.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,https://*.vercel.app

# Correo SMTP (Gmail con Contraseña de Aplicación)
MAIL_USERNAME=your-mail@example.com
MAIL_PASSWORD=change-me

# Cloudinary (Imágenes)
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Facturación electrónica
FACTURACION_API_URL=https://facturador.soft-solution.org/api/v1/facturacion/electronica
FACTURACION_API_TOKEN=change-me
